# Copy thành .env và chỉ điền provider nhóm sử dụng. Không commit secret thật.

# LLM: openrouter | openai | gemini | anthropic
LLM_PROVIDER=openrouter
# OpenRouter model IDs use provider/model, for example: openai/gpt-4o
LLM_MODEL=openai/gpt-4o

# Generation providers
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional OpenRouter attribution headers
OPENROUTER_SITE_URL=http://localhost:8501
OPENROUTER_APP_NAME=K4 RAG Pipeline

# Embedding: sentence_transformers | openai | gemini
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-m3
CHROMA_DIR=chroma_db

# Optional services
PAGEINDEX_API_KEY=
JINA_API_KEY=

# Hiệu chỉnh bằng query in-domain và out-of-domain trước khi điền.
SCORE_THRESHOLD=
